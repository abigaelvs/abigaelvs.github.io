@inject PortfolioData Data
@{ var p = Data.Profile; }
<section id="home" class="pb-16 pt-8 md:pb-8 md:pt-24">
    <div class="wrap grid gap-y-4 md:gap-y-20">
        <div class="grid grid-cols-[0.5fr_3fr] items-center gap-6 pt-14 max-[350px]:grid-cols-[0.25fr_3fr] min-[568px]:grid-cols-[max-content_1fr_1fr] md:gap-x-8 md:pt-[5.5rem]">
            <div class="grid grid-cols-[max-content] gap-y-4 lg:-translate-x-24">
                @foreach (var s in p.Socials)
                {
                    <a href="@s.Url" target="_blank" rel="noopener noreferrer" aria-label="@s.Name"
                       class="text-xl text-primary transition-colors hover:text-primary-alt">
                        <SocialIcon Name="@s.Icon" Size="20" />
                    </a>
                }
            </div>

            <div class="min-[568px]:order-1 min-[568px]:justify-self-center">
                <svg viewBox="0 0 200 187" class="w-[200px] fill-primary max-[350px]:w-[180px] md:w-[270px] lg:w-[320px]"
                     role="img" aria-label="@($"Portrait of {p.Name}")">
                    <mask id="blob-mask" mask-type="alpha">
                        <path d="M190.312 36.4879C206.582 62.1187 201.309 102.826 182.328 134.186C163.346 165.547 130.807 187.559 100.226 186.353C69.6454 185.297 41.0228 161.023 21.7403 129.362C2.45775 97.8511 -7.48481 59.1033 6.67581 34.5279C20.9871 10.1032 59.7028 -0.149132 97.9666 0.00163737C136.23 0.303176 174.193 10.857 190.312 36.4879Z" />
                    </mask>
                    <g mask="url(#blob-mask)">
                        <path d="M190.312 36.4879C206.582 62.1187 201.309 102.826 182.328 134.186C163.346 165.547 130.807 187.559 100.226 186.353C69.6454 185.297 41.0228 161.023 21.7403 129.362C2.45775 97.8511 -7.48481 59.1033 6.67581 34.5279C20.9871 10.1032 59.7028 -0.149132 97.9666 0.00163737C136.23 0.303176 174.193 10.857 190.312 36.4879Z" />
                        <image href="@p.Photo" x="12" y="20" width="170" />
                    </g>
                </svg>
            </div>

            <div class="col-span-2 min-[568px]:col-span-1">
                <h1 class="text-[2rem] font-semibold leading-[normal] md:text-5xl md:leading-[normal]">Hi, I'm @p.Name.Split(' ')[0]</h1>
                <h3 class="mb-3 text-[1.125rem] font-medium text-muted-foreground min-[968px]:text-xl">@p.Title</h3>
                <p class="mb-8">@p.Tagline</p>
                <SiteButton Href="#contact" Icon="send">Contact Me</SiteButton>
            </div>
        </div>

        <div class="hidden md:block">
            <a href="#about" class="ml-12 inline-flex items-center text-primary transition-transform hover:translate-y-1">
                <LucideIcon Name="mouse" Size="32" />
                <span class="ml-1 mr-1 text-sm font-medium text-foreground">Scroll Down</span>
                <LucideIcon Name="arrow-down" Size="20" />
            </a>
        </div>
    </div>
</section>
